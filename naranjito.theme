{
  "text-color": "#24242C",
  "background-color": "#F3F0E9",
  "line-number-color": "#9A958B",
  "line-number-background-color": null,
  "text-styles": {
    "Normal":         { "text-color": "#24242C" },
    "Keyword":        { "text-color": "#151F6C", "bold": true },
    "ControlFlow":    { "text-color": "#151F6C", "bold": true },
    "Function":       { "text-color": "#151F6C" },
    "BuiltIn":        { "text-color": "#151F6C" },
    "Import":         { "text-color": "#151F6C", "bold": true },
    "Preprocessor":   { "text-color": "#151F6C" },
    "DataType":       { "text-color": "#151F6C" },
    "Attribute":      { "text-color": "#151F6C" },
    "Variable":       { "text-color": "#7A3300" },
    "String":         { "text-color": "#A93A00" },
    "VerbatimString": { "text-color": "#A93A00" },
    "SpecialString":  { "text-color": "#A93A00" },
    "Char":           { "text-color": "#A93A00" },
    "SpecialChar":    { "text-color": "#A93A00" },
    "DecVal":         { "text-color": "#7A3300" },
    "BaseN":          { "text-color": "#7A3300" },
    "Float":          { "text-color": "#7A3300" },
    "Constant":       { "text-color": "#7A3300" },
    "Operator":       { "text-color": "#24242C" },
    "Comment":        { "text-color": "#5B6298" },
    "Documentation":  { "text-color": "#5B6298" },
    "CommentVar":     { "text-color": "#5B6298" },
    "Annotation":     { "text-color": "#5B6298" },
    "Information":    { "text-color": "#5B6298" },
    "Warning":        { "text-color": "#5B6298" },
    "Alert":          { "text-color": "#B00020", "bold": true },
    "Error":          { "text-color": "#B00020" },
    "Extension":      { "text-color": "#24242C" },
    "Other":          { "text-color": "#24242C" },
    "RegionMarker":   { "text-color": "#5B6298" }
  }
}
